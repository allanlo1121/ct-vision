    "@workspace/shared": "workspace:*",
    "@workspace/system": "workspace:*",
    "@workspace/notification": "workspace:*",
    "@workspace/tbm": "workspace:*",
    "@workspace/proj": "workspace:*",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "mqtt": "^5.15.1",
    "pg": "^8.21.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.8",
