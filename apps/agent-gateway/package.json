{
  "name": "@workspace/agent-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "prebuild": "node scripts/generate-build-info.mjs",
    "build": "tsup src/main.ts --format esm --platform node --out-dir dist",
    "start": "node --env-file=.env.production dist/main.js",
    "typecheck": "tsc --noEmit",
    "openapi": "tsx scripts/export-openapi.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^5.2.6",
    "@supabase/supabase-js": "^2.117.2",
    "@workspace/errors": "workspace:*",
    "@workspace/proj": "workspace:*",
    "@workspace/shared": "workspace:*",
    "@workspace/supabase": "workspace:*",
    "@workspace/system": "workspace:*",
    "@workspace/tbm": "workspace:*",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.21.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.8",
    "typescript": "^6.0.3"
  }
}