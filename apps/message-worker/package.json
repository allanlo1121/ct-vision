{
    "name": "@app/message-worker",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsup src/index.ts --format esm --platform node --target node22 --bundle --out-dir dist",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2",
        "dotenv": "^17",
        "zod": "^4",
        "@workspace/supabase": "workspace:*",
        "@workspace/errors": "workspace:*",
        "@workspace/shared": "workspace:*",
        "@workspace/notification": "workspace:*",
        "@workspace/hrm": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "tsx": "^4.23.8",
        "typescript": "^6.0.3"
    }
}